<UserControl x:Class="EasyScan.Desktop.Views.PreviewPane" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:EasyScan.Desktop.Controls">
  <Grid Background="{DynamicResource CanvasBrush}">
    <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="50"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource ShellBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <DockPanel Margin="16,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{DynamicResource GroupBrush}" CornerRadius="7" Padding="3" Margin="0,0,8,0" Visibility="{Binding IsCropping, Converter={StaticResource Visible}, ConverterParameter=Invert}">
            <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanSwitchPreview}">
              <RadioButton Content="结果" GroupName="PreviewMode" IsChecked="{Binding IsResult}"/>
              <RadioButton Content="原图" GroupName="PreviewMode" IsChecked="{Binding ShowOriginal}"/>
              <RadioButton Content="对比" GroupName="PreviewMode" IsChecked="{Binding ShowComparison}"/>
            </StackPanel>
          </Border>
          <Button Content="取消" Command="{Binding CancelCropCommand}" Margin="0,0,6,0" Visibility="{Binding IsCropping, Converter={StaticResource Visible}}"/>
          <Button Command="{Binding ToggleCropCommand}" Content="{Binding CropToolbarText}"/>
        </StackPanel>
        <TextBlock Text="{Binding SelectedPage.Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1">
      <controls:ImageViewport Source="{Binding DisplayPreview}" Zoom="{Binding Zoom, Mode=TwoWay}" PanX="{Binding PanX, Mode=TwoWay}" PanY="{Binding PanY, Mode=TwoWay}"
        Visibility="{Binding ShowSingle, Converter={StaticResource Visible}}" IsEnabled="{Binding CanZoom}" Margin="8"/>
      <Grid Visibility="{Binding ShowCompare, Converter={StaticResource Visible}}" Margin="12,16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="原图" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center"/>
        <TextBlock Text="扫描结果" Grid.Column="2" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center"/>
        <controls:ImageViewport Grid.Row="1" Source="{Binding OriginalPreview}" Zoom="{Binding Zoom, Mode=TwoWay}" PanX="{Binding PanX, Mode=TwoWay}" PanY="{Binding PanY, Mode=TwoWay}" IsEnabled="{Binding CanZoom}"/>
        <controls:ImageViewport Grid.Row="1" Grid.Column="2" Source="{Binding ProcessedPreview}" Zoom="{Binding Zoom, Mode=TwoWay}" PanX="{Binding PanX, Mode=TwoWay}" PanY="{Binding PanY, Mode=TwoWay}" IsEnabled="{Binding CanZoom}"/>
      </Grid>
      <controls:CropEditor Image="{Binding OriginalPreview}" Crop="{Binding SelectedPage.Crop, Mode=OneWay}" Edges="{Binding SelectedPage.CurvedEdges, Mode=OneWay}" ShowCurves="{Binding ShowCurveHandles, Mode=TwoWay}" SelectedHandle="{Binding SelectedCropHandle, Mode=TwoWay}" BoundaryCommitted="OnBoundaryCommitted" Visibility="{Binding IsCropping, Converter={StaticResource Visible}}" IsEnabled="{Binding CanCrop}"/>
      <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16" Padding="12,6" Background="{DynamicResource SurfaceBrush}" CornerRadius="5" Visibility="{Binding IsCropping, Converter={StaticResource Visible}}" IsHitTestVisible="False">
        <TextBlock Text="1–4 四角 · 5–8 弯边 · 方向键微调" Style="{StaticResource SecondaryText}"/>
      </Border>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasPages, Converter={StaticResource Visible}, ConverterParameter=Invert}">
        <Border Width="80" Height="80" Background="{DynamicResource SurfaceBrush}" CornerRadius="20" HorizontalAlignment="Center" Margin="0,0,0,24"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <TextBlock Text="把照片变成清晰扫描件" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,12"/>
        <TextBlock Text="拖入图片或 PDF" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,24"/>
        <Button Command="{Binding ImportCommand}" Style="{StaticResource PrimaryButton}" Content="选择文件" Width="136"/>
      </StackPanel>
      <controls:BusyIndicator IsBusy="{Binding IsPreviewBusy}" Text="{Binding PreviewBusyText}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"/>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowUnavailable, Converter={StaticResource Visible}}">
        <TextBlock Text="暂无可预览页面" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding SelectedPage.Error}" TextWrapping="Wrap" MaxWidth="360" Margin="0,0,0,12"/>
        <Button Content="重试未完成页面" Command="{Binding RetryCommand}"/>
      </StackPanel>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource ShellBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
      <DockPanel Margin="12,0">
        <Border DockPanel.Dock="Right" Background="{DynamicResource GroupBrush}" CornerRadius="7" Padding="3" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding ZoomOutCommand}" ToolTip="缩小" AutomationProperties.Name="缩小"><TextBlock Text="&#xE71F;" FontFamily="Segoe MDL2 Assets"/></Button>
            <TextBlock Text="{Binding ZoomLabel}" Width="48" TextAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
            <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding ZoomInCommand}" ToolTip="放大" AutomationProperties.Name="放大"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"/></Button>
            <Button Command="{Binding FitCommand}" Content="适应" Background="Transparent" Padding="10,6"/>
          </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding SelectedPage.Dimensions}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/><controls:HelpIcon Topic="zoom" Margin="4,0,0,0"/></StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>