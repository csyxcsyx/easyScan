<UserControl x:Class="EasyScan.Desktop.Views.ExportSettingsPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:EasyScan.Desktop.Controls" xmlns:views="clr-namespace:EasyScan.Desktop.Views">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,18,24,24" IsEnabled="{Binding CanConfigure}">
      <controls:HelpLabel Text="导出颜色" Topic="outputColor" TextElement.FontWeight="SemiBold" Margin="0,0,0,8"/>
      <Border Background="{DynamicResource GroupBrush}" CornerRadius="7" Padding="3"><UniformGrid Columns="3">
        <RadioButton GroupName="ExportColor" Content="彩色" IsChecked="{Binding IsColor}"/><RadioButton GroupName="ExportColor" Content="灰度" IsChecked="{Binding IsGrayscale}"/><RadioButton GroupName="ExportColor" Content="黑白" IsChecked="{Binding IsBinary}"/>
      </UniformGrid></Border>
      <StackPanel Margin="0,12,0,0" Visibility="{Binding IsBinary, Converter={StaticResource Visible}}"><controls:HelpLabel Text="黑白强度" Topic="binary"/><Slider Minimum="0" Maximum="100" Value="{Binding BinaryStrength}" AutomationProperties.Name="导出黑白强度"/></StackPanel>
      <TextBlock Text="导出范围" FontWeight="SemiBold" Margin="0,18,0,8"/>
      <ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding Scope}" DisplayMemberPath="Label" AutomationProperties.Name="导出范围"/>
      <controls:HelpLabel Text="导出形式" Topic="format" TextElement.FontWeight="SemiBold" Margin="0,18,0,8"/>
      <Border Background="{DynamicResource GroupBrush}" CornerRadius="7" Padding="3"><UniformGrid Columns="3">
        <RadioButton GroupName="OutputKind" Content="自动" IsChecked="{Binding IsAutomatic}"/><RadioButton GroupName="OutputKind" Content="图片" IsChecked="{Binding IsImage}"/><RadioButton GroupName="OutputKind" Content="PDF" IsChecked="{Binding IsPdfOutput}"/>
      </UniformGrid></Border>
      <StackPanel Margin="0,12,0,0" Visibility="{Binding IsImage, Converter={StaticResource Visible}}"><TextBlock Text="图片格式" Margin="0,0,0,8"/><ComboBox ItemsSource="{Binding ImageFormats}" SelectedItem="{Binding ImageFormat}" DisplayMemberPath="Label" AutomationProperties.Name="图片格式"/></StackPanel>
      <StackPanel Margin="0,12,0,0" Visibility="{Binding ShowQuality, Converter={StaticResource Visible}}"><Grid><controls:HelpLabel Text="JPG 质量" Topic="jpeg"/><TextBlock Text="{Binding JpegQuality, StringFormat={}{0:0}%}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><Slider Minimum="60" Maximum="100" Value="{Binding JpegQuality}" AutomationProperties.Name="JPG 质量"/></StackPanel>
      <StackPanel Visibility="{Binding ShowOrganization, Converter={StaticResource Visible}}" Margin="0,16,0,0"><controls:HelpLabel Text="文件组织" Topic="organization" Margin="0,0,0,8"/><ComboBox ItemsSource="{Binding Organizations}" SelectedItem="{Binding Organization}" DisplayMemberPath="Label" AutomationProperties.Name="文件组织"/></StackPanel>
      <StackPanel Margin="0,16,0,0" Visibility="{Binding IsPdf, Converter={StaticResource Visible}}">
        <controls:HelpLabel Text="白纸排版" Topic="layout" TextElement.FontWeight="SemiBold" Margin="0,0,0,8"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding LayoutModes}" SelectedItem="{Binding LayoutMode}" DisplayMemberPath="Label" AutomationProperties.Name="PDF 排版方式"/><ComboBox Grid.Column="2" ItemsSource="{Binding Orientations}" SelectedItem="{Binding Orientation}" DisplayMemberPath="Label" AutomationProperties.Name="纸张方向"/></Grid>
        <Expander Header="页边距与尺寸" Margin="0,10,0,0"><StackPanel Margin="0,6,0,0">
          <Grid><controls:HelpLabel Text="页边距" Topic="margin"/><TextBlock Text="{Binding MarginMm, StringFormat={}{0:0} mm}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><Slider Minimum="0" Maximum="30" Value="{Binding MarginMm}" SmallChange="1" AutomationProperties.Name="PDF 页边距毫米"/>
          <Grid Margin="0,8,0,0"><controls:HelpLabel Text="内容宽度" Topic="width"/><TextBlock Text="{Binding ContentWidth, StringFormat={}{0:0}%}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><Slider Minimum="30" Maximum="100" Value="{Binding ContentWidth}" SmallChange="1" AutomationProperties.Name="PDF 内容宽度百分比"/>
          <controls:HelpLabel Text="图片型 PDF · 300 DPI" Topic="dpi" TextElement.FontSize="12" TextElement.Foreground="{DynamicResource SecondaryBrush}" Margin="0,6,0,0"/>
        </StackPanel></Expander>
      </StackPanel>
      <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,18,0,14"/>
      <controls:HelpLabel Text="文字识别" Topic="ocr" TextElement.FontWeight="SemiBold" Margin="0,0,0,8"/>
      <CheckBox Content="同时导出文字 TXT" IsChecked="{Binding ExportOcrText}"/>
      <CheckBox Content="可搜索文字层" IsChecked="{Binding SearchablePdf}" Visibility="{Binding IsPdf, Converter={StaticResource Visible}}" Margin="0,10,0,0"/>
      <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,18,0,14"/>
      <views:WatermarkPanel/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
