<Window x:Class="EasyScan.Desktop.Views.ExportDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:EasyScan.Desktop.Views" xmlns:controls="clr-namespace:EasyScan.Desktop.Controls"
  Title="导出扫描件" Width="1040" Height="740" MinWidth="760" MinHeight="480" WindowStartupLocation="CenterOwner" Closing="OnClosing">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="112"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,0"><TextBlock Text="导出扫描件" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/></Border>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="348"/></Grid.ColumnDefinitions>
      <Grid Background="{DynamicResource CanvasBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
        <TextBlock Text="{Binding PreviewLabel}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="24,14" HorizontalAlignment="Center"/>
        <controls:ImageViewport Grid.Row="1" Source="{Binding Preview}" Zoom="{Binding PreviewZoom, Mode=TwoWay}" PanX="{Binding PreviewPanX, Mode=TwoWay}" PanY="{Binding PreviewPanY, Mode=TwoWay}" Margin="12" AutomationProperties.Name="最终导出效果预览"/>
        <Border Grid.Row="2" Background="{DynamicResource GroupBrush}" CornerRadius="7" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="3">
          <StackPanel Orientation="Horizontal"><Button Command="{Binding PreviousPreviewCommand}" Style="{StaticResource ToolbarIconButton}" AutomationProperties.Name="上一张导出预览"><TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets"/></Button><TextBlock Text="{Binding PreviewCount, StringFormat=共 {0} 页}" Margin="12,0" VerticalAlignment="Center" FontSize="12"/><Button Command="{Binding NextPreviewCommand}" Style="{StaticResource ToolbarIconButton}" AutomationProperties.Name="下一张导出预览"><TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"/></Button></StackPanel>
        </Border>
        <controls:BusyIndicator Grid.Row="1" IsBusy="{Binding IsPreviewLoading}" Text="正在更新导出预览…" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"/>
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="7" Padding="14" Margin="24" VerticalAlignment="Center" Visibility="{Binding HasPreviewError, Converter={StaticResource Visible}}"><TextBlock Text="{Binding PreviewError}" TextWrapping="Wrap"/></Border>
      </Grid>
      <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"><views:ExportSettingsPanel/></Border>
    </Grid>
    <Expander Grid.Row="2" Header="失败详情" Background="{DynamicResource SurfaceBrush}" Padding="24,8" Visibility="{Binding HasFailures, Converter={StaticResource Visible}}" IsExpanded="True">
      <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Failures}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,6"><TextBlock Text="{Binding FileName}" FontWeight="SemiBold"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    </Expander>
    <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,12">
      <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel IsEnabled="{Binding CanConfigure}" Margin="0,0,0,6"><TextBlock DockPanel.Dock="Left" Text="保存位置" VerticalAlignment="Center" Margin="0,0,12,0"/><Button DockPanel.Dock="Right" Command="{Binding ChooseFolderCommand}" Content="选择文件夹" Margin="8,0,0,0"/><TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="保存位置"/></DockPanel>
      <DockPanel Grid.Row="1">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="打开文件夹" Click="OnOpenFolder" Margin="0,0,8,0"/>
          <Button Content="关闭" Click="OnClose" Margin="0,0,8,0" IsEnabled="{Binding CanConfigure}"/>
          <Button Content="取消" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" Margin="0,0,8,0"/>
          <Button Content="开始导出" Command="{Binding ExportCommand}" Style="{StaticResource PrimaryButton}" Padding="20,10"/>
        </StackPanel>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis"/>
          <ProgressBar Height="3" Maximum="{Binding PageCount}" Value="{Binding Completed}" Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource BorderBrush}" BorderThickness="0" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}"/>
        </StackPanel>
      </DockPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
